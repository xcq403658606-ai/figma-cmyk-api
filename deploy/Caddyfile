{$EDC_API_DOMAIN} {
  encode zstd gzip

  @api path /health /process-image /v1/*
  handle @api {
    reverse_proxy api:8787 {
      transport http {
        keepalive 60s
      }
    }
  }

  handle {
    respond "Not found" 404
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }

  request_body {
    max_size 160MB
  }
}
